using Gym.BLL.Services.Interfaces;
using Gym.BLL.ViewModels.MemberViewModels;
using Microsoft.AspNetCore.Mvc;

namespace Gym.Controllers
{
    public class MemberController : Controller
    {
        private readonly IMemberServices memberServices;

        public MemberController(IMemberServices memberReositories)
        {
            this.memberServices = memberReositories;
        }

        public async Task<IActionResult> Index(CancellationToken ct)
        {
            var members = await memberServices.GetAllMemberAsync(ct);
            return View(members);
        }

        [HttpGet]
        public IActionResult Create()
        {
            return View();
        }

        [HttpPost]
        public async Task <IActionResult> CreateMember(CreateMemberViewModel model,CancellationToken ct)
        {
            if (!ModelState.IsValid) return View(nameof(Create), model);
           var result =  await memberServices.CreateMemberAsync(model, ct);
            if (result) TempData["Success"] = "Member Created Successfuly";
            else TempData["Failed"] = "Member Creation Failed";


            return Redirect(nameof(Index));

        }
        [HttpGet]

        public async Task<IActionResult> Details(int id ,CancellationToken ct)
        {
            var member = await memberServices.GetMemberDetailsAsync(id, ct);
            if(member == null)  { TempData["ErrorMsg"] = "Member not found"; }
            return View(member);
        }

        [HttpGet]
        public async Task <IActionResult> HealthRecordDetails(int id, CancellationToken ct)
        {
            var healthRecord = await memberServices.GetMemberHealthRecordAsync(id, ct);
            if (healthRecord == null) { TempData["ErrorMsg"] = "Health Record not found"; }
            return View(healthRecord);
        }
        [HttpGet]
        public async Task<IActionResult> Edit(int id, CancellationToken ct)
        {
            var member = await memberServices.GetMembeToUpdateAsync(id, ct);
            if (member == null) { TempData["ErrorMsg"] = "Member not found"; }
            return View(member);
        }

        [HttpPost]
        public async Task <IActionResult> EditMember (int id ,CancellationToken ct)
        {
            if (!ModelState.IsValid) return View(nameof(Edit));
            var result = await memberServices.GetMembeToUpdateAsync(id, ct);
            if (result)
                TempData["Success"] = "Updated Successfuly";
            else
                TempData["Failed"] = "Failed TO Update";
            return RedirectToAction(nameof(Index));


        }
    }
}
